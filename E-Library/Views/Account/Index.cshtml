@model IEnumerable<E_Library.ViewModels.BookFormViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- 🔹 Stats Row -->
<div class="row">

    <div class="col-lg-4">
        <div class="card bg-primary-subtle">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <iconify-icon icon="solar:book-outline" class="fs-6 text-primary"></iconify-icon>
                    <h6>Total Books</h6>
                </div>
                <h3 class="mt-3">@ViewBag.TotalBooks</h3>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card bg-success-subtle">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <iconify-icon icon="solar:user-outline" class="fs-6 text-success"></iconify-icon>
                    <h6>Total Users</h6>
                </div>
                <h3 class="mt-3">@ViewBag.TotalUsers</h3>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card bg-warning-subtle">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <iconify-icon icon="solar:layers-outline" class="fs-6 text-warning"></iconify-icon>
                    <h6>Total Categories</h6>
                </div>
                <h3 class="mt-3">@ViewBag.TotalCategories</h3>
            </div>
        </div>
    </div>

</div>

<div class="row mt-4">

    <!-- 📚 Table -->
    <div class="col-lg-8">
        <div class="card p-3">
            <h5>Recent Books</h5>

            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                   @foreach (var book in Model)
                    {
                        <tr>
                            <td>@book.Name</td>
                            <td>@book.CategoryName</td>
                            <td>
                                <a href="/Book/ReadBook/@book.Id" class="btn btn-sm btn-primary">Read</a>
                                <a href="/Book/DownloadBook/@book.Id" class="btn btn-sm btn-success">Download</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

    <!-- 📊 Chart -->
    <div class="col-lg-4">
        <div class="card p-3">
            <h5>Books by Category</h5>
            <div id="chart"></div>
        </div>
    </div>

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            var labels = @Html.Raw(Json.Serialize(ViewBag.CategoriesName));
            var data = @Html.Raw(Json.Serialize(ViewBag.CategoriesCount));

            var options = {
                chart: {
                    type: 'pie'
                },
                series: data,
                labels: labels,
                colors: ['#ff0000', '#0000ff', '#00ff00', '#ffa500']
            };

            var chart = new ApexCharts(document.querySelector("#chart"), options);
            chart.render();

        });
    </script>
}