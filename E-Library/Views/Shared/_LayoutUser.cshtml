    <!--<< Magnific Popup Js >>-->
    <script src="~/Templates/User/assets/js/jquery.magnific-popup.min.js"></script>
    <!--<< Wow Animation Js >>-->
    <script src="~/Templates/User/assets/js/wow.min.js"></script>
    <!-- Gsap -->
    <script src="~/Templates/User/assets/js/gsap.min.js"></script>
    <!--<< Main.js >>-->
