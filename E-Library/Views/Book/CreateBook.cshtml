@model E_Library.ViewModels.BookFormViewModel
@{
    ViewData["Title"] = "CreateBook";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<div class="container-fluid">
        <div class="card">
            <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="card-title fw-semibold mb-4">Add Book</h5>
                <a asp-action="BookList" class="btn btn-primary">
                    <i class="fas fa-list"></i> View Book List
                </a>
            </div>
            <div class="card">
                <div class="card-body">
                <form asp-action="CreateBook" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="name" class="form-label">Book Name</label>
                        <input asp-for=Name type="text" class="form-control" id="name">
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <input asp-for=Description type="text" class="form-control" id="description">
                    </div>
                    <div class="mb-3">
                        <label for="image" class="form-label">Image</label>
                        <input asp-for=ImageFile type="file" name="imageFile" class="form-control" id="image">
                            <span asp-validation-for="ImageFile" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PdfFile" class="form-label">Upload PDF</label>
                            <input asp-for="PdfFile" type="file" name="pdfFile" class="form-control" accept=".pdf">
                        <span asp-validation-for="PdfFile" class="text-danger"></span>
                    </div>

                   @*  <div class="mb-3 form-check">
                        <input asp-for="IsAvailableOnline" class="form-check-input">
                        <label asp-for="IsAvailableOnline" class="form-check-label">Available for online reading</label>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="AllowDownload" class="form-check-input">
                        <label asp-for="AllowDownload" class="form-check-label">Allow PDF download</label>
                    </div> *@

                    <div class="mb-3">
                        <label for="category" class="form-label">Category</label>
                        <select asp-for="CategoryId" asp-items="Model.CategoryList" class="form-control" id="category">
                            <option value="">--select--</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end align-items-center gap-3 mt-3">
                        <a asp-action="BookList" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Add</button>
                    </div>

                </form>
                </div>
            </div>
            </div>
        </div>
    </div>


